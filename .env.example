# Required – Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional – AVis (Reviewly) API integration
# Base URL of the review app (e.g. https://reviewly-ma.vercel.app). Used by server to call /api/businesses/search.
AVIS_API_URL=
# Public base URL for "View on Reviewly" links in the browser. Defaults to AVIS_API_URL or https://reviewly-ma.vercel.app if unset.
NEXT_PUBLIC_AVIS_SITE_URL=

# Optional – Analytics / Ads
# NEXT_PUBLIC_ADSENSE_CLIENT=
# NEXT_PUBLIC_GA_MEASUREMENT_ID=
# NEXT_PUBLIC_SITE_URL=
